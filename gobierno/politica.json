{
  "estado": "~/.yema",
  "aprobadoras": [
    "operadora"
  ],
  "efectos_sin_contrato": [
    "leer"
  ],
  "zonas_libres": [
    "contratos/borradores/*",
    "buzon/salida/*",
    "memoria/*"
  ],
  "cupulas_lectura": [
    "SaviaDomains"
  ],
  "lectura_vetada": [
    "~/.ssh/*",
    "~/.gnupg/*",
    "~/.azure/*",
    "~/.aws/*",
    "~/.config/gh/hosts.yml",
    "~/.savia/confidentiality-key",
    "~/.savia/grants/*",
    "~/.local/share/opencode/auth.json",
    "*.env",
    ".env.*",
    "*.pem",
    "*.key"
  ],
  "copias": "~/.yema-copias",
  "descanso": {
    "desde": 23,
    "hasta": 8
  },
  "savia": "~/savia",
  "terminos_privados": "~/.yema/terminos-privados.txt"
}
